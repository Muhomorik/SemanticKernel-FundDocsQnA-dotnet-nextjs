<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Dependency Injection -->
    <PackageReference Include="Autofac" Version="9.3.4" />

    <!-- Reactive Extensions for IObservable -->
    <PackageReference Include="System.Reactive" Version="7.0.0" />

    <!-- PDF Processing -->
    <PackageReference Include="PdfPig" Version="0.1.16" />

    <!-- Image Processing for OCR -->
    <PackageReference Include="SixLabors.ImageSharp" Version="4.1.3" />

    <!-- HTTP client for LM Studio/OpenAI APIs -->
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.14" />

    <!-- Logging -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.14" />

    <!-- PDF to Image conversion for OCR -->
    <PackageReference Include="PDFtoImage" Version="5.4.0" />
  </ItemGroup>

</Project>
