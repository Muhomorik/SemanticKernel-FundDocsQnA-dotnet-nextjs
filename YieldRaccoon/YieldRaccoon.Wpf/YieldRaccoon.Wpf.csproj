<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.26100.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Pulls in Microsoft.VisualBasic.ApplicationServices for single-instance support. -->
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Custom Main lives in Program.cs for single-instance wrapping. -->
    <StartupObject>YieldRaccoon.Wpf.Program</StartupObject>
    <UserSecretsId>8729093f-fe34-4e8a-9f2f-4311264e3379</UserSecretsId>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>AnyCPU;x64</Platforms>
    <ApplicationIcon>Resources\YieldRaccoon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="YieldRaccoon.Wpf.Tests" />
  </ItemGroup>

  <!-- UseWindowsForms=true pulls in Microsoft.VisualBasic.Forms (needed for
       WindowsFormsApplicationBase single-instance support) but also adds
       System.Windows.Forms + System.Drawing to implicit usings, which collide
       with System.Windows.Controls types used in this WPF project. Remove those
       implicit usings; code that actually needs WinForms types is only Program.cs. -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\YieldRaccoon.Application\YieldRaccoon.Application.csproj" />
    <ProjectReference Include="..\YieldRaccoon.Infrastructure\YieldRaccoon.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Dependency Injection -->
    <PackageReference Include="Autofac" Version="9.0.0" />

    <!-- DevExpress MVVM (free version) -->
    <PackageReference Include="DevExpressMvvm" Version="24.1.6" />

    <!-- Configuration -->
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="9.0.1" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" Version="9.0.0" />

    <!-- Reactive Extensions for IObservable -->
    <PackageReference Include="System.Reactive" Version="6.1.0" />

    <!-- MahApps.Metro for modern UI -->
    <PackageReference Include="MahApps.Metro" Version="2.4.11" />

    <!-- WebView2 for embedded Chromium browser -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />

    <!-- CLI argument parsing -->
    <PackageReference Include="CommandLineParser" Version="2.9.1" />

    <!-- Windows Task Scheduler wrapper (for daily auto-start feature) -->
    <PackageReference Include="TaskScheduler" Version="2.11.0" />

    <!-- Logging -->
    <PackageReference Include="NLog" Version="6.0.7" />
    <PackageReference Include="NLog.Extensions.Logging" Version="6.1.0" />

    <!-- ImageMagick for streaming mode effects -->
    <PackageReference Include="Magick.NET-Q8-AnyCPU" Version="14.10.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- ApplicationIcon adds .ico as None; override to Resource so WPF pack URIs work -->
    <None Remove="Resources\YieldRaccoon.ico" />
    <Resource Include="Resources\YieldRaccoon.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- Copy NLog.config to output directory -->
    <None Include="NLog.config">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- Copy appsettings.json to output directory -->
    <None Include="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
