<mah:MetroWindow
    x:Class="YieldRaccoon.Wpf.Views.ExportWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
    xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="clr-namespace:YieldRaccoon.Wpf.ViewModels"
    Title="Export"
    Width="550"
    Height="380"
    MinWidth="450"
    MinHeight="340"
    d:DataContext="{d:DesignInstance viewModels:ExportWindowViewModel,
                                     IsDesignTimeCreatable=True}"
    Icon="/Resources/YieldRaccoon.ico"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    TitleCharacterCasing="Normal"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">

    <dxmvvm:Interaction.Behaviors>
        <dxmvvm:CurrentWindowService ClosingCommand="{Binding WindowClosingCommand}" />
    </dxmvvm:Interaction.Behaviors>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <!--  Form fields / warning  -->
            <RowDefinition Height="Auto" />
            <!--  Status + progress  -->
            <RowDefinition Height="*" />
            <!--  Buttons  -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  SQLite-only warning (visible when NOT SQLite)  -->
        <StackPanel
            Grid.Row="0"
            Orientation="Horizontal"
            Visibility="{Binding IsSqliteProvider, Converter={dxmvvm:BooleanToVisibilityConverter Inverse=True}}">
            <TextBlock
                Margin="0,0,4,0"
                VerticalAlignment="Center"
                FontFamily="Segoe Fluent Icons"
                FontSize="14"
                Foreground="{StaticResource yr.WarningBrush}"
                Text="&#xE7BA;" />
            <TextBlock
                VerticalAlignment="Center"
                Foreground="{StaticResource yr.WarningBrush}"
                Style="{StaticResource yr.BodyStyle}"
                Text="Export is only available when using the SQLite database provider." />
        </StackPanel>

        <!--  Form fields (visible when SQLite)  -->
        <StackPanel
            Grid.Row="0"
            Visibility="{Binding IsSqliteProvider, Converter={dxmvvm:BooleanToVisibilityConverter}}">

            <!--  Description  -->
            <TextBlock
                Margin="0,0,0,12"
                Foreground="{StaticResource MahApps.Brushes.Gray2}"
                Style="{StaticResource yr.CaptionStyle}"
                Text="Export filtered fund data to a standalone database file."
                TextWrapping="Wrap" />

            <!--  Period + Min owners  -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock
                    Grid.Row="0"
                    Grid.Column="0"
                    Margin="{StaticResource yr.LabelSpacing}"
                    Style="{StaticResource yr.SubheaderStyle}"
                    Text="Time period" />
                <ComboBox
                    Grid.Row="1"
                    Grid.Column="0"
                    Width="160"
                    HorizontalAlignment="Left"
                    ItemsSource="{Binding Periods}"
                    SelectedItem="{Binding SelectedPeriod}" />

                <TextBlock
                    Grid.Row="0"
                    Grid.Column="2"
                    Margin="{StaticResource yr.LabelSpacing}"
                    Style="{StaticResource yr.SubheaderStyle}"
                    Text="Min owners" />
                <mah:NumericUpDown
                    Grid.Row="1"
                    Grid.Column="2"
                    Width="120"
                    HorizontalAlignment="Left"
                    Minimum="0"
                    NumericInputMode="Numbers"
                    Value="{Binding MinNumberOfOwners}" />
            </Grid>

            <!--  Company name  -->
            <TextBlock
                Margin="0,20,0,4"
                Style="{StaticResource yr.SubheaderStyle}"
                Text="Company name" />
            <TextBox
                mah:TextBoxHelper.Watermark="Enter company name..."
                Text="{Binding CompanyName, UpdateSourceTrigger=PropertyChanged}" />

            <!--  Output file  -->
            <TextBlock
                Margin="0,20,0,4"
                Style="{StaticResource yr.SubheaderStyle}"
                Text="Output file" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox
                    Grid.Column="0"
                    Margin="0,0,8,0"
                    mah:TextBoxHelper.Watermark="Export database path..."
                    Text="{Binding OutputPath, UpdateSourceTrigger=PropertyChanged}" />

                <Button
                    Grid.Column="1"
                    Width="80"
                    Command="{Binding BrowseCommand}"
                    Content="Browse..."
                    Style="{StaticResource yr.ButtonStyle}" />
            </Grid>
        </StackPanel>

        <!--  Status + progress (visible when SQLite)  -->
        <StackPanel
            Grid.Row="1"
            Margin="0,12,0,0"
            VerticalAlignment="Top"
            Visibility="{Binding IsSqliteProvider, Converter={dxmvvm:BooleanToVisibilityConverter}}">

            <!--  Progress indicator  -->
            <StackPanel
                Orientation="Horizontal"
                Visibility="{Binding IsExporting, Converter={dxmvvm:BooleanToVisibilityConverter}}">
                <mah:ProgressRing
                    Width="16"
                    Height="16"
                    IsActive="True" />
                <TextBlock
                    Margin="8,0,0,0"
                    VerticalAlignment="Center"
                    Style="{StaticResource yr.CaptionStyle}"
                    Text="Exporting..." />
            </StackPanel>

            <!--  Status message with icon  -->
            <StackPanel
                Orientation="Horizontal"
                Visibility="{Binding StatusMessage, Converter={dxmvvm:StringToBooleanConverter}, ConverterParameter=Inverse}">
                <TextBlock
                    x:Name="StatusIcon"
                    Margin="0,0,4,0"
                    VerticalAlignment="Center"
                    FontFamily="Segoe Fluent Icons"
                    FontSize="12">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="&#xE73E;" />
                            <Setter Property="Foreground" Value="{StaticResource yr.SuccessBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                                    <Setter Property="Text" Value="&#xE783;" />
                                    <Setter Property="Foreground" Value="{DynamicResource yr.ErrorBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock
                    VerticalAlignment="Center"
                    Text="{Binding StatusMessage}"
                    TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style BasedOn="{StaticResource yr.CaptionStyle}" TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource yr.SuccessBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource yr.ErrorBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </StackPanel>

        <!--  Buttons  -->
        <Grid Grid.Row="2">
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <Button
                    Width="80"
                    Margin="0,0,8,0"
                    Command="{Binding ExportCommand}"
                    Content="Export"
                    IsDefault="True"
                    Style="{StaticResource yr.ButtonAccentStyle}" />
                <Button
                    Width="80"
                    Command="{Binding CloseCommand}"
                    Content="Close"
                    IsCancel="True"
                    Style="{StaticResource yr.ButtonStyle}" />
            </StackPanel>
        </Grid>
    </Grid>
</mah:MetroWindow>
