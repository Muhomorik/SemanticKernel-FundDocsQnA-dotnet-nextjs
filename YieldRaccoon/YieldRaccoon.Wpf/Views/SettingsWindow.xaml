<mah:MetroWindow
    x:Class="YieldRaccoon.Wpf.Views.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
    xmlns:mahShared="http://metro.mahapps.com/winfx/xaml/shared"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="clr-namespace:YieldRaccoon.Wpf.ViewModels"
    Title="Settings"
    Width="550"
    Height="860"
    MinWidth="450"
    MinHeight="780"
    d:DataContext="{d:DesignInstance viewModels:SettingsWindowViewModel,
                                     IsDesignTimeCreatable=True}"
    Icon="/Resources/YieldRaccoon.ico"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    TitleCharacterCasing="Normal"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Database Provider Section  -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock
                Margin="{StaticResource yr.LabelSpacing}"
                Style="{StaticResource yr.SubheaderStyle}"
                Text="Database provider" />
            <ComboBox
                Width="280"
                HorizontalAlignment="Left"
                ItemsSource="{Binding AvailableProviders}"
                SelectedItem="{Binding SelectedProvider}" />
        </StackPanel>

        <!--  Database Location Section (visible only for SQLite/DualWrite)  -->
        <StackPanel
            Grid.Row="1"
            Margin="0,0,0,8"
            Visibility="{Binding IsDatabasePathVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock
                Margin="{StaticResource yr.LabelSpacing}"
                Style="{StaticResource yr.SubheaderStyle}"
                Text="Database location" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox
                    Grid.Column="0"
                    Margin="0,0,8,0"
                    mah:TextBoxHelper.Watermark="Database file path..."
                    Text="{Binding DatabasePath, UpdateSourceTrigger=PropertyChanged}" />

                <Button
                    Grid.Column="1"
                    Width="80"
                    Command="{Binding BrowseCommand}"
                    Content="Browse..."
                    Style="{StaticResource yr.ButtonStyle}" />
            </Grid>
        </StackPanel>

        <!--  Backend API Section (visible only for DualWrite)  -->
        <StackPanel
            Grid.Row="2"
            Margin="0,0,0,8"
            Visibility="{Binding IsBackendApiVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock
                Margin="{StaticResource yr.LabelSpacing}"
                Style="{StaticResource yr.SubheaderStyle}"
                Text="Backend API URL" />
            <PasswordBox
                Margin="0,0,0,4"
                Style="{StaticResource MahApps.Styles.PasswordBox.Win8}"
                mah:TextBoxHelper.Watermark="https://your-app.azurewebsites.net"
                mahShared:PasswordBoxBindingBehavior.Password="{Binding BackendApiUrl, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />

            <TextBlock
                Margin="0,0,0,8"
                Foreground="{StaticResource yr.ErrorBrush}"
                Style="{StaticResource yr.SmallStyle}"
                Text="{Binding BackendApiUrlError}"
                Visibility="{Binding IsBackendApiUrlInvalid, Converter={StaticResource BooleanToVisibilityConverter}}" />

            <TextBlock
                Margin="{StaticResource yr.LabelSpacing}"
                Style="{StaticResource yr.SubheaderStyle}"
                Text="API key" />
            <PasswordBox
                Style="{StaticResource MahApps.Styles.PasswordBox.Win8}"
                mah:TextBoxHelper.Watermark="Enter API key..."
                mahShared:PasswordBoxBindingBehavior.Password="{Binding BackendApiKey, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
        </StackPanel>

        <!--  Default Crawler Steps Section  -->
        <StackPanel Grid.Row="3" Margin="0,0,0,8">
            <TextBlock
                Margin="{StaticResource yr.LabelSpacing}"
                Style="{StaticResource yr.SubheaderStyle}"
                Text="Default crawler steps" />
            <TextBlock
                Margin="{StaticResource yr.CompactSpacing}"
                Foreground="{DynamicResource MahApps.Brushes.Gray3}"
                Style="{StaticResource yr.SmallStyle}"
                Text="Select which time periods to collect by default" />
            <ItemsControl
                Margin="{StaticResource yr.CompactSpacing}"
                ItemsSource="{Binding StepToggles}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="4" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <CheckBox
                            Margin="0,2"
                            Content="{Binding Label}"
                            IsChecked="{Binding IsEnabled}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <!--  Daily Auto-Start Section  -->
        <StackPanel Grid.Row="4" Margin="0,0,0,12">
            <TextBlock
                Margin="{StaticResource yr.LabelSpacing}"
                Style="{StaticResource yr.SubheaderStyle}"
                Text="Daily auto-start" />

            <TextBlock
                Margin="{StaticResource yr.CompactSpacing}"
                Foreground="{DynamicResource MahApps.Brushes.Gray3}"
                Style="{StaticResource yr.SmallStyle}"
                Text="Launch YieldRaccoon daily at a fixed time via Windows Task Scheduler" />

            <mah:ToggleSwitch
                Margin="{StaticResource yr.CompactSpacing}"
                HorizontalAlignment="Left"
                IsOn="{Binding AutoStartEnabled}"
                OffContent="Disabled"
                OnContent="Enabled" />

            <mah:TimePicker
                Width="140"
                Margin="{StaticResource yr.ItemSpacing}"
                HorizontalAlignment="Left"
                Culture="de-DE"
                IsEnabled="{Binding AutoStartEnabled}"
                SelectedDateTime="{Binding AutoStartTime}"
                SelectedTimeFormat="Short" />

            <CheckBox
                Margin="{StaticResource yr.ItemSpacing}"
                Content="Start fund list crawl automatically (--auto-list)"
                IsChecked="{Binding AutoStartPassAutoListFlag}"
                IsEnabled="{Binding AutoStartEnabled}" />

            <TextBlock
                Margin="{StaticResource yr.CompactSpacing}"
                Foreground="{DynamicResource MahApps.Brushes.Gray2}"
                Style="{StaticResource yr.SmallStyle}"
                TextWrapping="Wrap">
                <Run Text="Managed as a Windows scheduled task under" />
                <Run FontFamily="Consolas" Text="\YieldRaccoon\YieldRaccoon-AutoStart" />
                <LineBreak />
                <Run Text="— inspect, run, or disable it manually via" />
                <Run FontFamily="Consolas" Text="taskschd.msc" />
                <Run Text="(Windows Task Scheduler)." />
            </TextBlock>

            <TextBlock
                Margin="{StaticResource yr.CompactSpacing}"
                Foreground="{StaticResource yr.ErrorBrush}"
                Style="{StaticResource yr.SmallStyle}"
                Text="{Binding AutoStartError}"
                TextWrapping="Wrap"
                Visibility="{Binding IsAutoStartErrorVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
        </StackPanel>

        <!--  Weekly Statistics Export Section  -->
        <StackPanel Grid.Row="5" Margin="0,0,0,12">
            <TextBlock
                Margin="{StaticResource yr.LabelSpacing}"
                Style="{StaticResource yr.SubheaderStyle}"
                Text="Weekly statistics export" />

            <TextBlock
                Margin="{StaticResource yr.CompactSpacing}"
                Foreground="{DynamicResource MahApps.Brushes.Gray3}"
                Style="{StaticResource yr.SmallStyle}"
                Text="Uses the latest settings from the Statistics export window." />

            <mah:ToggleSwitch
                Margin="{StaticResource yr.CompactSpacing}"
                HorizontalAlignment="Left"
                IsOn="{Binding WeeklyExportEnabled}"
                OffContent="Disabled"
                OnContent="Enabled" />

            <StackPanel
                Margin="{StaticResource yr.ItemSpacing}"
                Orientation="Horizontal">
                <ComboBox
                    Width="140"
                    Margin="0,0,8,0"
                    IsEnabled="{Binding WeeklyExportEnabled}"
                    ItemsSource="{Binding DaysOfWeek}"
                    SelectedItem="{Binding WeeklyExportDay}" />

                <mah:TimePicker
                    Width="140"
                    Culture="de-DE"
                    IsEnabled="{Binding WeeklyExportEnabled}"
                    SelectedDateTime="{Binding WeeklyExportTime}"
                    SelectedTimeFormat="Short" />
            </StackPanel>

            <TextBlock
                Margin="{StaticResource yr.CompactSpacing}"
                Foreground="{DynamicResource MahApps.Brushes.Gray2}"
                Style="{StaticResource yr.SmallStyle}"
                Text="{Binding WeeklyExportLastRunSummary}"
                Visibility="{Binding HasWeeklyExportLastRun, Converter={StaticResource BooleanToVisibilityConverter}}" />

            <TextBlock
                Margin="{StaticResource yr.CompactSpacing}"
                Foreground="{StaticResource yr.ErrorBrush}"
                Style="{StaticResource yr.SmallStyle}"
                Text="{Binding WeeklyExportError}"
                TextWrapping="Wrap"
                Visibility="{Binding IsWeeklyExportErrorVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
        </StackPanel>

        <!--  Info text  -->
        <TextBlock
            Grid.Row="6"
            Margin="0,0,0,8"
            Foreground="{DynamicResource MahApps.Brushes.Gray2}"
            Style="{StaticResource yr.SmallStyle}"
            TextWrapping="Wrap">
            <Run Text="Settings file:" />
            <Run Text="{Binding SettingsFilePath, Mode=OneWay}" />
        </TextBlock>

        <!--  Restart warning  -->
        <StackPanel
            Grid.Row="7"
            Margin="{StaticResource yr.ItemSpacing}"
            VerticalAlignment="Top"
            Orientation="Horizontal"
            Visibility="{Binding HasRestartChanges, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock
                Margin="0,0,4,0"
                VerticalAlignment="Center"
                FontFamily="Segoe Fluent Icons"
                FontSize="14"
                Foreground="{StaticResource yr.WarningBrush}"
                Text="&#xE7BA;" />
            <TextBlock
                VerticalAlignment="Center"
                Foreground="{StaticResource yr.WarningBrush}"
                Style="{StaticResource yr.CaptionStyle}"
                Text="Restart required for changes to take effect" />
        </StackPanel>

        <!--  Buttons  -->
        <Grid Grid.Row="9">
            <Button
                HorizontalAlignment="Left"
                Command="{Binding ResetToDefaultCommand}"
                Content="Reset to default"
                Style="{StaticResource yr.ButtonStyle}" />
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <Button
                    Width="80"
                    Margin="0,0,8,0"
                    Command="{Binding SaveCommand}"
                    Content="Save"
                    IsDefault="True"
                    Style="{StaticResource yr.ButtonAccentStyle}" />
                <Button
                    Width="80"
                    Command="{Binding CancelCommand}"
                    Content="Cancel"
                    IsCancel="True"
                    Style="{StaticResource yr.ButtonStyle}" />
            </StackPanel>
        </Grid>
    </Grid>
</mah:MetroWindow>
