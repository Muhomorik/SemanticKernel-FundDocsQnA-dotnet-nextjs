<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Platforms>AnyCPU;x64</Platforms>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="YieldRaccoon.Infrastructure.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\YieldRaccoon.Domain\YieldRaccoon.Domain.csproj" />
    <ProjectReference Include="..\YieldRaccoon.Application\YieldRaccoon.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Statistical computations (mean, std, skewness) for fund analytics -->
    <PackageReference Include="MathNet.Numerics" Version="5.0.0" />

    <!-- Reactive Extensions for IObservable -->
    <PackageReference Include="System.Reactive" Version="7.0.0" />

    <!-- HTTP client for web scraping -->
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.14" />

    <!-- HTML parsing (for web scraping) -->
    <PackageReference Include="HtmlAgilityPack" Version="1.13.1" />

    <!-- Logging -->
    <PackageReference Include="NLog" Version="6.2.2" />

    <!-- Entity Framework Core for SQLite persistence -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.14" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.14" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
